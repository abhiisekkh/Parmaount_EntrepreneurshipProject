rules_version = '2';

// Firestore security rules for Paramount app
// WARNING: These rules are intentionally permissive for authenticated users
// and include a development fallback. Review and tighten rules before
// deploying to production (limit writes, validate data shapes, enforce
// role-based checks, etc.).

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    // - Allow users to read their own document and update it
    // - Allow authenticated users to read other user profiles (teacher/student lists)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Attendance: authenticated users can read and write attendance records.
    // Consider requiring a teacher role for writes in production.
    match /attendance/{attendanceId} {
      allow read, write: if request.auth != null;
    }

    // Subjects: basic authenticated access
    match /subjects/{subjectId} {
      allow read, write: if request.auth != null;
    }

    // Classes: basic authenticated access
    match /classes/{classId} {
      allow read, write: if request.auth != null;
    }

    // Notifications: authenticated users can read and write their notifications
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }

    // Assignments: authenticated users can read and write assignments
    match /assignments/{assignmentId} {
      allow read, write: if request.auth != null;
    }

    // Development fallback (keep only for testing). Remove or restrict in production.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
